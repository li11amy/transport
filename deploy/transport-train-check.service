[Unit]
Description=Private, on-demand Renfe trip checks via transport Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Sites/transport
EnvironmentFile=/home/ubuntu/.config/transport-update.env
ExecStart=/usr/bin/python3 -u /home/ubuntu/Sites/transport/telegram_train_check.py
Restart=always
RestartSec=8
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
ReadWritePaths=/home/ubuntu/Sites/transport/output
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
